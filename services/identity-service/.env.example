# =============================================================================
# Identity Service configuration
# =============================================================================
# The service reads these from process.env. For a local (non-Docker) run,
# copy this file to `.env`:
#
#     cp .env.example .env
#
# Under docker compose the values are injected by docker-compose.yml — no
# .env file is needed (and none is copied into the image).
#
# NOTE: unlike the backend, this service uses POSTGRES_* variable names.
# =============================================================================

# --- HTTP ---
PORT=5001

# --- Database (same PostgreSQL instance as the banking backend) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger_dev_password
POSTGRES_DB=ledger

# --- JWT ---
# Must be THE SAME value the banking backend uses, or every token issued here is
# rejected by the API. The backend additionally requires 32+ characters.
JWT_SECRET=change-me-please-generate-a-random-32-plus-char-secret
JWT_EXPIRATION_HOURS=24

# --- Customer provisioning (calls the backend's internal endpoint) ---
# Base URL only — the service appends /api/v1/internal/customers.
# In Docker this is http://banking-backend:5000
CUSTOMER_SERVICE_URL=http://localhost:5000

# Must be THE SAME value the banking backend uses, or provisioning returns 401.
CUSTOMER_PROVISIONING_SECRET=change-me-please-generate-a-random-secret
