# =============================================================================
# Root environment for `docker compose up --build`
# =============================================================================
# Copy this file to `.env` and adjust the values:
#
#     cp .env.example .env
#
# Docker Compose reads `.env` from this directory automatically and uses it for
# ${VARIABLE} substitution in docker-compose.yml. `.env` is git-ignored — never
# commit real secrets.
#
# Every value below has a development-safe default baked into docker-compose.yml,
# so the stack also boots with no `.env` file at all. Set the secrets explicitly
# for anything beyond a local machine.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (compose service "postgres")
# -----------------------------------------------------------------------------
# Single database shared by the backend and the identity service — there is no
# separate database per service.
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger_dev_password
POSTGRES_DB=ledger

# Host port for `psql` access from your machine. Postgres is published on the
# loopback interface only (127.0.0.1); it is never exposed on the network.
POSTGRES_HOST_PORT=5432

# -----------------------------------------------------------------------------
# Shared application secrets
# -----------------------------------------------------------------------------
# MUST be identical in banking-backend, identity-service, and customer-service:
# all verify the same JWTs; Identity and Banking call Customer Service's
# protected internal API with CUSTOMER_PROVISIONING_SECRET.
#
# JWT_SECRET must be at least 32 characters or the backend refuses to start.
# Generate with:  openssl rand -hex 32
JWT_SECRET=change-me-please-generate-a-random-32-plus-char-secret
JWT_EXPIRATION_HOURS=24

# Generate with:  openssl rand -hex 32
CUSTOMER_PROVISIONING_SECRET=change-me-please-generate-a-random-secret
CUSTOMER_SERVICE_URL=http://localhost:5002

# -----------------------------------------------------------------------------
# Application tuning
# -----------------------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

IDEMPOTENCY_TTL_SECONDS=3600
IDEMPOTENCY_CLEANUP_INTERVAL_MS=3600000

# ---------------------------------------------------------------------------
# Banking outbox (disabled locally unless an SQS queue is configured)
# ---------------------------------------------------------------------------
OUTBOX_PUBLISHER_ENABLED=false
OUTBOX_SQS_QUEUE_URL=
AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# The URL the BROWSER uses to reach the API Gateway. It is baked into the
# JavaScript bundle at image build time, so it must be reachable from your
# machine — never use a Docker service name (e.g. http://api-gateway:4000) here.
VITE_API_BASE_URL=http://localhost:4000/api/v1
